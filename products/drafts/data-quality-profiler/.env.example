# Data Quality Profiler — non-secret example configuration.
# Copy to .env or export in the shell. The zero-like wallet below is an
# EXAMPLE ONLY for local/testnet development; it is not a real receiving address.

HOST=0.0.0.0
PORT=4021

# Payment boundary (testnet, envelope-only in tests).
X402_ENABLED=false
X402_NETWORK=eip155:84532
X402_PRICE=$0.02
X402_PAY_TO=0x0000000000000000000000000000000000000001
X402_FACILITATOR_URL=https://x402.org/facilitator

# Base mainnet remains fail-closed. Keep false.
ALLOW_MAINNET=false