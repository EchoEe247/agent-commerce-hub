{
  "id": "product-listing-graphic",
  "name": "Product Listing Graphic",
  "status": "draft",
  "version": "0.2.0",
  "description": "Create one deterministic product-listing graphic from a supplied workspace image or a blank canvas. Supplied images are preserved in a dedicated upper image zone above a separate title/price panel; blank-canvas jobs retain the gradient-overlay layout.",
  "execution": {
    "kind": "private-local-worker",
    "adapter": "tools/cshop-worker-adapter",
    "runtime": "stubbb/c-shop",
    "runtimeCommit": "f3b2033c07df92e8e72ff83a29955a2c10494d95",
    "publicEndpoint": false
  },
  "input": {
    "required": ["title"],
    "optional": [
      "price",
      "asset",
      "output",
      "width",
      "height",
      "titleSize",
      "priceSize",
      "background",
      "titleColor",
      "priceColor",
      "overlayFrom",
      "overlayTo"
    ],
    "defaults": {
      "width": 1200,
      "height": 1200,
      "output": "product-graphic.png",
      "background": "#111827",
      "titleColor": "#ffffff",
      "priceColor": "#f9fafb",
      "overlayFrom": "#00000000",
      "overlayTo": "#000000cc"
    },
    "limits": {
      "width": { "min": 256, "max": 4096 },
      "height": { "min": 256, "max": 4096 },
      "titleCharacters": { "min": 1, "max": 120 },
      "priceCharacters": { "min": 1, "max": 40 },
      "outputFormats": ["png", "jpg", "jpeg"]
    }
  },
  "layout": {
    "suppliedAsset": {
      "mode": "contained-photo-plus-text-panel",
      "imageZone": "upper 64% of canvas",
      "textPanel": "lower 36% of canvas",
      "sourceAspectRatio": "preserved",
      "sourceCropping": "none by default",
      "gradientOverlay": false,
      "backgroundColour": "input.background"
    },
    "blankCanvas": {
      "mode": "gradient-overlay",
      "gradientOverlay": true
    }
  },
  "output": {
    "deliverable": "full-size exported PNG or JPEG",
    "preview": "bounded MCP preview for inspection",
    "report": "C-Shop execution report"
  },
  "boundaries": {
    "rawScriptAccepted": false,
    "styleCommandsEnabled": false,
    "pathComponentsAccepted": false,
    "rendererLoopbackByDefault": true,
    "remoteRendererRequiresExplicitOptInAndBearerToken": true,
    "subjectDetection": false,
    "backgroundRemoval": false
  },
  "validation": {
    "adapterTests": "5/5 PASS before v0.2 layout change; rerun required",
    "cshopBuild": "PASS",
    "cshopWorkspaceTests": "PASS",
    "realMcpSmoke": "PASS",
    "historicalSmokeOutput": "1200 x 1200 RGBA PNG, 151467 bytes",
    "runtimeReceipt": "handoffs/hermes-to-chatgpt/cshop-worker-runtime-validation-2026-08-29.json",
    "fullBleedAssetLayout": "FAIL human visual review",
    "v0.2SplitLayout": "PENDING real runtime and human visual acceptance"
  },
  "commercial": {
    "pricingStatus": "unset",
    "paymentIntegration": "not-configured",
    "published": false,
    "deployed": false
  }
}
