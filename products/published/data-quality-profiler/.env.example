# Data Quality Profiler / Counterparty Availability — non-secret example configuration.
# Copy to .env or export in the shell. The zero-like wallet below is an
# EXAMPLE ONLY; replace it with the seller receiving address before deployment.

HOST=0.0.0.0
PORT=4021

X402_ENABLED=false
X402_NETWORK=eip155:84532
X402_PRICE=$0.02
X402_LOCALE_PRICE=$0.03
X402_PAY_TO=0x0000000000000000000000000000000000000001

# XPay remains the default facilitator and needs no CDP credentials.
X402_FACILITATOR_MODE=xpay
X402_FACILITATOR_URL=https://facilitator.xpay.sh

# Optional Coinbase CDP/Bazaar mode. Never commit real credential values.
# X402_FACILITATOR_MODE=cdp
# CDP_API_KEY_ID=organizations/.../apiKeys/...
# CDP_API_KEY_SECRET=<secret from secure runtime configuration>

# Mainnet remains fail-closed unless both fields are explicitly changed:
# X402_NETWORK=eip155:8453
# ALLOW_MAINNET=true
ALLOW_MAINNET=false
