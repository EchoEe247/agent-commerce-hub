# Data Quality Profiler / Counterparty Availability — non-secret example configuration.
# Copy to .env or export in the shell. The zero-like wallet below is an
# EXAMPLE ONLY; replace it with the seller receiving address before deployment.

HOST=0.0.0.0
PORT=4021

X402_ENABLED=false
X402_NETWORK=eip155:84532
X402_PRICE=$0.02
X402_LOCALE_PRICE=$0.03
X402_PAY_TO=0x0000000000000000000000000000000000000001
X402_FACILITATOR_URL=https://x402.org/facilitator

# Mainnet remains fail-closed unless both fields are explicitly changed:
# X402_NETWORK=eip155:8453
# ALLOW_MAINNET=true
ALLOW_MAINNET=false
