# Data Quality Profiler / Hermes Agent Commerce API — non-secret example configuration.
# Copy to .env or export in the shell for local development. The zero-like
# wallet below is an EXAMPLE ONLY; never commit a real private key or secret.

HOST=0.0.0.0
PORT=4021

# Local development is an explicit unpaid mode. Omitting X402_PAYMENT_MODE is
# fail-closed and resolves to production mode, so keep this line for local use.
X402_PAYMENT_MODE=local-unpaid
X402_ENABLED=false
X402_NETWORK=eip155:84532
X402_PRICE=$0.02
X402_LOCALE_PRICE=$0.03
X402_PAY_TO=0x0000000000000000000000000000000000000001
ALLOW_MAINNET=false

# XPay is the default facilitator and needs no CDP credentials.
X402_FACILITATOR_MODE=xpay
X402_FACILITATOR_URL=https://facilitator.xpay.sh

# Optional Coinbase CDP facilitator mode. Never commit real credential values.
# X402_FACILITATOR_MODE=cdp
# CDP_API_KEY_ID=organizations/.../apiKeys/...
# CDP_API_KEY_SECRET=<secret from secure runtime configuration>

# Production example — do not enable casually. Production mode requires a
# valid receiving address and X402_ENABLED=true. Base mainnet additionally
# requires ALLOW_MAINNET=true. Real production values belong in secure runtime
# configuration, not this file.
# X402_PAYMENT_MODE=production
# X402_ENABLED=true
# X402_NETWORK=eip155:8453
# ALLOW_MAINNET=true
# X402_PAY_TO=0x<valid-40-hex-character-evm-address>
